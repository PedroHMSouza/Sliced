<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Avisos do timer de descanso (Android 13+ pede permissão em tempo de execução). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibração ao fim do descanso. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Alarme exato para o fim do descanso tocar na hora certa, mesmo com a tela apagada.
         USE_EXACT_ALARM vale do Android 13 em diante (apps de timer); antes disso, SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Android 16: permite que a contagem apareça como "Live Update" (Now Bar no One UI 8). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:name=".SlicedApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sliced">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".timer.RestAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
